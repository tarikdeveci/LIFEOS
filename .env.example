# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API (Supabase Edge Functions'da kullanılır)
ANTHROPIC_API_KEY=your-claude-api-key

# Web uygulaması URL (deployment URL'si)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# İyzico Ödeme Sistemi
# Sandbox: https://sandbox.iyzipay.com
# Production: https://api.iyzipay.com
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key

# Expo (mobil)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=your-google-mobile-client-id
EXPO_PUBLIC_OUTLOOK_CALENDAR_CLIENT_ID=your-microsoft-mobile-client-id
