# Kopyala: marketing/organic/data/.env (git'e girmez). Gercek ortam degiskeni dosyayi ezer.
# Uzun omurlu Page/System User token (instagram_basic, instagram_content_publish, pages_read_engagement, instagram_manage_insights)
META_ACCESS_TOKEN=
# Instagram professional hesap ID (Page'e bagli, graph.facebook.com/<page-id>?fields=instagram_business_account ile bulunur)
META_IG_USER_ID=
# Opsiyonel: yalnizca platforms icinde "facebook" olan item'lar icin (pages_manage_posts gerekir)
META_PAGE_ID=
# Opsiyonel: varsayilan v27.0
META_GRAPH_VERSION=
