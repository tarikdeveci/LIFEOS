{
  "name": "lifeos",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@lifeos/web",
    "dev:mobile": "turbo run dev --filter=@lifeos/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lifeos/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/types/database.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "typescript": "~5.9.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "next": "^15.5.21"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.8.4 <2",
      "@babel/core": "7.29.7",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4 <8",
      "undici": ">=6.27.0 <7",
      "ws@6": ">=6.2.4 <7",
      "ws@7": ">=7.5.11 <8",
      "ws@8": ">=8.21.0 <9",
      "js-yaml@3": ">=3.15.0 <4",
      "js-yaml@4": ">=4.2.0 <5",
      "postcss": ">=8.5.10 <9",
      "tar": ">=7.5.21 <8",
      "uuid@11": ">=11.1.1 <12",
      "@xmldom/xmldom": ">=0.8.13 <0.9",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@2": ">=2.1.2 <3",
      "brace-expansion@5": ">=5.0.8 <6",
      "sharp": ">=0.35.0 <1"
    }
  }
}
