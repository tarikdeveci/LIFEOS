# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
out
build
.expo

# Native projeler (CNG prebuild çıktısı). apps/mobile/.gitignore bunları zaten
# dışarıda tutuyor, ama EAS CLI Windows'ta alt klasörlerdeki .gitignore'ları
# uygulamıyor (yol ayırıcı farkı) ve yerel android/ build arşivine giriyor.
# Kökte de yazınca EAS her build'de temiz prebuild yapar.
/apps/mobile/android
/apps/mobile/ios

# Store build artifacts (.ipa / .aab) — never commit
dist-store/
graphify-out/
*.ipa
*.aab

# Ham çalışma görselleri (telefon/WhatsApp çekimleri — mağaza girdisi değil)
lifeos mobile pic/

# Store/signing credentials — hangi klasörde olursa olsun asla commit'lenmesin
*.p8
*.keystore
*.jks
google-services-key.json

# Environment
.env
.env.local
.env.*.local
.env.production

# Turbo
.turbo

# Supabase
supabase/.temp
supabase/.branches

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Types (generated — uncomment if using supabase gen types)
# packages/shared/src/types/database.ts

.vercel

# Claude Code local settings (may contain API keys/tokens)
.claude/settings.local.json

# Claude memory files (personal user data)
memory/

# Seed scripts with personal data / hardcoded keys
scripts/seed-user-data.mjs

# Build info
*.tsbuildinfo

# Claude Code worktree'leri (her biri deponun tam kopyasi, EAS arsivini sisiriyor)
.claude/worktrees/

# Ham reels videolari (GB boyutunda; EAS arsivine de giriyordu)
marketing/reels/

# Persona testi ham raporlari ve ekran.mjs durum dosyasi (repoya girmez)
.claude/skills/persona-test/raporlar/
